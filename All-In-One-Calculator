from kivy.app import App
from kivy.uix.tabbedpanel import TabbedPanel, TabbedPanelItem
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.gridlayout import GridLayout
from kivy.uix.button import Button
from kivy.uix.textinput import TextInput
from kivy.uix.label import Label
from kivy.uix.spinner import Spinner
from kivy.uix.image import Image
import math, os
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
import numpy as np

BG = (0.12, 0.12, 0.18, 1)
COLORS = {"tri": (0.2, 0.6, 1, 1), "graph": (0.6, 0.4, 1, 1), "peri": (0.2, 0.8, 0.6, 1), "alg": (0.9, 0.4, 0.7, 1), "com": (1, 0.9, 0.2, 1)}

class FinalApp(App):
    def build(self):
        self.title = "All Subject Calculator"
        tabs = TabbedPanel(do_default_tab=False, background_color=BG)
        tabs.add_widget(self.make_graph_tab())
        tabs.add_widget(self.make_tri_tab())
        tabs.add_widget(self.make_peri_tab())
        tabs.add_widget(self.make_alg_tab())
        tabs.add_widget(self.make_com_tab())
        return tabs

    def make_graph_tab(self):
        t = TabbedPanelItem(text='Graph', background_color=COLORS["graph"])
        b = BoxLayout(orientation="vertical", padding=10, spacing=10)
        b.add_widget(Label(text="Plot y = Graph", font_size=24, bold=True, size_hint=(1,0.1)))
        
        self.graph_spinner = Spinner(
            text='y = x^2 (Parabola)', 
            values=('y = x^2 (Parabola)','y = sin(x)','y = cos(x)','y = x^3','y = log(x)','y = 2^x (Exponential)'), 
            size_hint=(1,0.12), background_color=COLORS["graph"])
        
        self.graph_img = Image(source='', size_hint=(1,0.6))
        
        g_input = BoxLayout(size_hint=(1,0.12), spacing=10)
        g_input.add_widget(Label(text="Range - to + :"))
        self.g_range = TextInput(text="10", multiline=False, hint_text="e.g. 10 means -10 to 10")
        g_input.add_widget(self.g_range)
        
        btn = Button(text="Draw Graph", font_size=22, bold=True, background_color=COLORS["graph"], background_normal='', size_hint=(1,0.15))
        btn.bind(on_press=self.draw_graph)
        
        b.add_widget(self.graph_spinner); b.add_widget(g_input); b.add_widget(btn); b.add_widget(self.graph_img)
        t.add_widget(b); return t

    def draw_graph(self, _):
        try:
            r = float(self.g_range.text or 10)
            x = np.linspace(-r, r, 400)
            choice = self.graph_spinner.text
            
            plt.clf()
            plt.style.use('dark_background')
            fig, ax = plt.subplots()
            fig.patch.set_facecolor('#1e1e2e')
            ax.set_facecolor('#1e1e2e')
            
            if 'x^2' in choice: y = x**2; label="y = x^2"
            elif 'sin' in choice: y = np.sin(x); label="y = sin(x)"
            elif 'cos' in choice: y = np.cos(x); label="y = cos(x)"
            elif 'x^3' in choice: y = x**3; label="y = x^3"
            elif 'log' in choice: x = np.linspace(0.1, r, 400); y = np.log(x); label="y = log(x)"
            else: y = 2**x; label="y = 2^x"
            
            ax.plot(x, y, color='#a78bfa', linewidth=3)
            ax.grid(True, alpha=0.3)
            ax.set_title(label, color='white', fontsize=16)
            ax.axhline(0, color='white', linewidth=0.8); ax.axvline(0, color='white', linewidth=0.8)
            
            path = "/tmp/graph.png"
            plt.savefig(path, dpi=150, bbox_inches='tight')
            self.graph_img.source = path
            self.graph_img.reload()
        except Exception as e:
            print(e)

    def make_tri_tab(self):
        t = TabbedPanelItem(text='Trigonometry', background_color=COLORS["tri"])
        b = BoxLayout(orientation="vertical", padding=15, spacing=10)
        self.tri_s = Spinner(text='sin', values=('sin','cos','tan'), size_hint=(1,0.15), background_color=COLORS["tri"])
        self.tri_i = TextInput(hint_text="Degree: 30", multiline=False, size_hint=(1,0.15))
        btn = Button(text="Calculate", background_color=COLORS["tri"], background_normal='', size_hint=(1,0.15)); btn.bind(on_press=self.calc_tri)
        self.tri_r = Label(text="Result", font_size=28); b.add_widget(self.tri_s); b.add_widget(self.tri_i); b.add_widget(btn); b.add_widget(self.tri_r); t.add_widget(b); return t
    def calc_tri(self,_):
        try:
            deg=float(self.tri_i.text); rad=math.radians(deg)
            f=self.tri_s.text; r=math.sin(rad) if f=='sin' else math.cos(rad) if f=='cos' else math.tan(rad)
            self.tri_r.text=f"{f}({deg})={r:.4f}"
        except: self.tri_r.text="Error"

    def make_peri_tab(self):
        t=TabbedPanelItem(text='Mensuration', background_color=COLORS["peri"]); b=BoxLayout(orientation="vertical", padding=10, spacing=10)
        self.pe_s=Spinner(text='Circle', values=('Circle','Triangle','Rectangle','Sphere'), size_hint=(1,0.15), background_color=COLORS["peri"])
        self.pe1=TextInput(hint_text="r/base", multiline=False); self.pe2=TextInput(hint_text="h/width", multiline=False)
        btn=Button(text="Calculate", background_color=COLORS["peri"], background_normal=''); btn.bind(on_press=self.calc_pe)
        self.pe_r=Label(text="Result"); b.add_widget(self.pe_s); b.add_widget(self.pe1); b.add_widget(self.pe2); b.add_widget(btn); b.add_widget(self.pe_r); t.add_widget(b); return t
    def calc_pe(self,_):
        try:
            a=float(self.pe1.text or 0); b=float(self.pe2.text or 0); ch=self.pe_s.text
            if ch=='Circle': res=math.pi*a*a
            elif ch=='Triangle': res=0.5*a*b
            elif ch=='Rectangle': res=a*b
            else: res=(4/3)*math.pi*a**3
            self.pe_r.text=f"{res:.2f}"
        except: self.pe_r.text="Error"

    def make_alg_tab(self):
        t=TabbedPanelItem(text='Algebra', background_color=COLORS["alg"]); b=BoxLayout(orientation="vertical", padding=10, spacing=10)
        self.al_s=Spinner(text='Arithmetic Series', values=('Arithmetic Series','Geometric Series','a^b','log'), size_hint=(1,0.15), background_color=COLORS["alg"])
        self.al1=TextInput(hint_text="a", multiline=False); self.al2=TextInput(hint_text="d/r/b", multiline=False); self.al3=TextInput(hint_text="n", multiline=False)
        btn=Button(text="Calculate", background_color=COLORS["alg"], background_normal=''); btn.bind(on_press=self.calc_al)
        self.al_r=Label(text="Result"); b.add_widget(self.al_s); b.add_widget(self.al1); b.add_widget(self.al2); b.add_widget(self.al3); b.add_widget(btn); b.add_widget(self.al_r); t.add_widget(b); return t
    def calc_al(self,_):
        try:
            a=float(self.al1.text or 0); b=float(self.al2.text or 0); n=float(self.al3.text or 0); ch=self.al_s.text
            if 'Arithmetic' in ch: res=n/2*(2*a+(n-1)*b)
            elif 'Geometric' in ch: res=a*(b**n-1)/(b-1) if b!=1 else a*n
            elif 'a^b' in ch: res=a**b
            else: res=math.log(n,a)
            self.al_r.text=f"{res:.4f}"
        except: self.al_r.text="Error"

    def make_com_tab(self):
        t=TabbedPanelItem(text='Commerce', background_color=COLORS["com"]); b=BoxLayout(orientation="vertical", padding=10, spacing=10)
        self.co_s=Spinner(text='EMI', values=('Simple Interest','Compound','EMI','Profit %'), size_hint=(1,0.15), background_color=COLORS["com"])
        self.co1=TextInput(hint_text="Principal", multiline=False); self.co2=TextInput(hint_text="Rate", multiline=False); self.co3=TextInput(hint_text="Time", multiline=False)
        btn=Button(text="Calculate", background_color=(0.3,0.3,0.3,1), background_normal=''); btn.bind(on_press=self.calc_co)
        self.co_r=Label(text="Result", color=(0,0,0,1)); b.add_widget(self.co_s); b.add_widget(self.co1); b.add_widget(self.co2); b.add_widget(self.co3); b.add_widget(btn); b.add_widget(self.co_r); t.add_widget(b); return t
    def calc_co(self,_):
        try:
            p=float(self.co1.text or 0); r=float(self.co2.text or 0); t_=float(self.co3.text or 0); ch=self.co_s.text
            if 'Simple' in ch: res=(p*r*t_)/100
            elif 'Compound' in ch: res=p*(1+r/100)**t_
            elif 'EMI' in ch: mr=r/12/100; n=t_; res=p*mr*(1+mr)**n/((1+mr)**n-1) if mr!=0 else p/n
            else: res=((t_-r)/r*100) if r!=0 else 0
            self.co_r.text=f"{res:.2f}"
        except: self.co_r.text="Error"

FinalApp().run()
